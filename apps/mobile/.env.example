# Next.js API dev server. iOS Simulator can reach the Mac's localhost directly;
# Android emulator needs http://10.0.2.2:3000 instead; a physical device needs
# your Mac's LAN IP (e.g. http://192.168.1.23:3000).
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Google Cloud Console > APIs & Services > Credentials > OAuth client IDs
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID="xxxx.apps.googleusercontent.com"
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID="xxxx.apps.googleusercontent.com"
