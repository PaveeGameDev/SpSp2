# Same Neon connection strings as packages/db/.env
DATABASE_URL="postgresql://user:password@host-pooler/dbname?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require&channel_binding=require"

# Secret used to sign the app's own session JWT (returned by /api/auth/callback)
JWT_SECRET="change-me-to-a-long-random-string"

# Comma-separated list of Google OAuth client IDs to accept as valid audiences
# (Expo/iOS/Android/web client IDs from Google Cloud Console can differ per platform)
GOOGLE_CLIENT_IDS="xxxx.apps.googleusercontent.com"

# Your app's bundle identifier, checked as the `aud` claim on Apple identity tokens
APPLE_BUNDLE_ID="com.yourteam.speedysponsor"

# Shared secret checked against Vercel Cron's request to /api/cron/monthly-reset
CRON_SECRET="change-me-to-a-long-random-string"
