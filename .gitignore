# Dependencies
node_modules/

# Environment variables (secrets) — keep the .env.example templates tracked
.env
.env.local
.env.*.local
!.env.example

# Build output
dist/
build/
out/
*.tsbuildinfo
coverage/

# Next.js (apps/api)
.next/
next-env.d.ts
.vercel

# Expo / React Native (apps/mobile)
.expo/
expo-env.d.ts
web-build/
.metro-health-check*
*.orig.*

# Native projects generated by `expo prebuild` — managed workflow, not committed
/apps/mobile/ios/
/apps/mobile/android/

# Mobile signing credentials — never commit
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editor / OS
.DS_Store
.idea/
